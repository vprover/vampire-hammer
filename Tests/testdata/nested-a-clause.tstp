% This proof intentionally retains Vampire's native quantified A-clause
% surface spelling.  In particular, f3 is *not* parser-normalized from
%   (! [X] : t_a0(X)) | ~spl0_1
% to a quantified whole disjunction.  Replay must recognize the nested
% binder while decoding and construct its internal A-clause representation.
tff(type_s_a0, type, s_a0: $tType).
tff(type_t_a0, type, t_a0: (s_a0 > $o)).
tff(type_t_a1, type, t_a1: s_a0).
tff(fact0, axiom, (~ $false),
  file('nested-a-clause.p', fact0)).
tff(fact1, axiom, (~ (t_a0(t_a1) | (~ $true))),
  file('nested-a-clause.p', fact1)).
tff(fact2, axiom, (! [X0: s_a0] : t_a0(X0)),
  file('nested-a-clause.p', fact2)).
tff(f2, definition, (spl0_1 <=> $true),
  introduced(definition,[new_symbols(definition,[spl0_1])],[avatar_definition])).
tff(f3, plain, (( ! [X0: s_a0] : t_a0(X0)) | ~spl0_1),
  inference(cnf_transformation,[],[fact2])).
tff(f4, plain, $false, inference(resolution,[],[fact1,f3])).
