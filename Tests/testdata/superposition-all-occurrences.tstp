% A small ground superposition proof used to check the replay backend.
% In f12, the equality t_a0 = t_a1 is used right-to-left in every occurrence
% of t_a1 in the selected literal ~t_a3(t_a1,t_a1).
tff(type_def_5, type, s_a0: $tType).
tff(func_def_0, type, t_a0: s_a0).
tff(func_def_1, type, t_a1: s_a0).
tff(pred_def_2, type, t_a2: $o).
tff(pred_def_3, type, t_a3: ((s_a0 * s_a0) > $o)).
tff(f2,axiom,(
  t_a0 = t_a1 | t_a2),
  file('<stdin>','fact1')).
tff(f3,axiom,(
  ~t_a2),
  file('<stdin>','fact2')).
tff(f4,axiom,(
  t_a3(t_a0,t_a0)),
  file('<stdin>','fact3')).
tff(f5,axiom,(
  ~t_a3(t_a1,t_a1)),
  file('<stdin>','fact4')).
tff(f7,plain,(
  t_a0 = t_a1 | t_a2),
  inference(cnf_transformation,[],[f2])).
tff(f7a,plain,(
  t_a2 | t_a0 = t_a1),
  inference(associativity_commutativity,[permutation([1,0])],[f7])).
tff(f8,plain,(
  ~t_a2),
  inference(cnf_transformation,[],[f3])).
tff(f9,plain,(
  t_a3(t_a0,t_a0)),
  inference(cnf_transformation,[],[f4])).
tff(f10,plain,(
  ~t_a3(t_a1,t_a1)),
  inference(cnf_transformation,[],[f5])).
tff(f12,plain,(
  ~t_a3(t_a0,t_a0) | t_a2),
  inference(superposition,[unifier([subs(f10,[]),subs(f7a,[])]),rewritten_literal(literal(f10,0))],[f10,f7a])).
tff(f13,plain,(
  t_a2),
  inference(resolution,[unifier([subs(f12,[]),subs(f9,[])]),resolved_literals([literal(f12,0),literal(f9,0)])],[f12,f9])).
tff(f14,plain,(
  $false),
  inference(forward_subsumption_resolution,[unifier([]),resolved_literals([literal(f13,0),literal(f8,0)])],[f13,f8])).
