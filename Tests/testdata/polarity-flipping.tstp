% Deterministic coverage for consistent_polarity_flipping.
%
% After clausification Vampire flips the unary t_a0 and the nullary t_a2:
% every literal keeps its position and flipped literals change sign. From f7
% on, both names denote the complemented predicates, and the ordinary
% resolution steps f10 and f11 use that reading.
tff(type_s_a0, type, s_a0: $tType).
tff(type_t_a0, type, t_a0: (s_a0 > $o)).
tff(type_t_a1, type, t_a1: s_a0).
tff(type_t_a2, type, t_a2: $o).
tff(f1, axiom, (! [X0: s_a0] : t_a0(X0)), file('<stdin>', 'fact1')).
tff(f2, axiom, ((~ t_a0(t_a1)) | t_a2), file('<stdin>', 'fact2')).
tff(f3, axiom, (~ t_a2), file('<stdin>', 'fact3')).
tff(f4, plain, (! [X0: s_a0] : t_a0(X0)),
  inference(cnf_transformation, [], [f1])).
tff(f5, plain, ((~ t_a0(t_a1)) | t_a2),
  inference(cnf_transformation, [], [f2])).
tff(f6, plain, (~ t_a2),
  inference(cnf_transformation, [], [f3])).
tff(f7, plain, (! [X0: s_a0] : (~ t_a0(X0))),
  inference(consistent_polarity_flipping, [], [f4])).
tff(f8, plain, (t_a0(t_a1) | (~ t_a2)),
  inference(consistent_polarity_flipping, [], [f5])).
tff(f9, plain, (t_a2),
  inference(consistent_polarity_flipping, [], [f6])).
tff(f10, plain, (~ t_a2),
  inference(resolution,
    [unifier([subs(f8, []), subs(f7, [b(X0, t_a1)])]),
     resolved_literals([literal(f8, 0), literal(f7, 0)])],
    [f8, f7])).
tff(f11, plain, ($false),
  inference(resolution,
    [unifier([subs(f9, []), subs(f10, [])]),
     resolved_literals([literal(f9, 0), literal(f10, 0)])],
    [f9, f10])).
