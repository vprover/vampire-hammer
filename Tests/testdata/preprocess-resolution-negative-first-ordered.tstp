% The first parent resolves on ~b. Its remaining literals must still stay
% before the second parent's remaining literals: a | c | d.  The parser-side
% pass must leave this node alone; `Clause.resolveNegatedFirst` reconstructs
% the same parent order in Lean.
tff(type_a, type, a: $o).
tff(type_b, type, b: $o).
tff(type_c, type, c: $o).
tff(type_d, type, d: $o).
tff(negative_parent, axiom, (~ b | a | c), file('<stdin>', 'fact0')).
tff(positive_parent, axiom, (d | b), file('<stdin>', 'fact1')).
tff(r, plain, (a | c | d),
  inference(resolution,
    [unifier([subs(negative_parent, []), subs(positive_parent, [])]),
     resolved_literals([literal(negative_parent, 0), literal(positive_parent, 1)])],
    [negative_parent, positive_parent])).
