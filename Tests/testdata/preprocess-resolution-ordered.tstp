% This version displays the natural resolution order a | c | d. It must not
% acquire a no-op associativity_commutativity node.
tff(type_a, type, a: $o).
tff(type_b, type, b: $o).
tff(type_c, type, c: $o).
tff(type_d, type, d: $o).
tff(p, axiom, (a | b | c), file('<stdin>', 'fact0')).
tff(n, axiom, (~ b | d), file('<stdin>', 'fact1')).
tff(r, plain, (a | c | d),
  inference(resolution,
    [unifier([subs(p, []), subs(n, [])]),
     resolved_literals([literal(p, 1), literal(n, 0)])],
    [p, n])).
