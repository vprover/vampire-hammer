import VampireHammer.Preprocess.Clause

/-!
Syntax-level AVATAR clause views and AC origin/certificate helpers.
-/

namespace VampireHammer.Preprocess.Internal

open Tptp.Data

/-! ## A-clause surface normalization

Vampire prints a quantified regular component beside its AVATAR literals:

    `(! [X] : P(X) | Q(X)) | ~spl0_1`

The proof backend represents this as a quantifier around an A-clause with an
ordered regular list `[P X, Q X]` and a set-like AVATAR list `[~spl0_1]`.
Normalizing the parser AST here makes the regular literals available to the
existing resolution permutation pass. AVATAR order is intentionally not an
inference concern after this representation boundary.
-/

/- Look through harmless parentheses and recognize a universally quantified
top-level clause disjunct. -/
mutual

private partial def quantifiedClauseUnit?
    (unit : TffUnitFormula) : Option (TffVariableList × List TffUnitFormula) :=
  match unit with
  | .tffUnitaryFormula (.tffQuantifiedFormula
      (.mk (.fofQuantifier .exclamation) variables body)) => do
    pure (variables, ← flattenUnit body)
  | .tffUnitaryFormula (.tffLogicFormula formula) => quantifiedClauseLogic? formula
  | _ => none

private partial def quantifiedClauseLogic?
    (formula : TffLogicFormula) : Option (TffVariableList × List TffUnitFormula) :=
  match formula with
  | .tffUnitaryFormula unitary =>
    quantifiedClauseUnit? (.tffUnitaryFormula unitary)
  | _ => none

end

/-- Separate the unique quantified regular disjunct from its siblings while
retaining the siblings' left-to-right order. -/
private partial def takeQuantifiedClause :
    List TffUnitFormula →
      Option (TffVariableList × List TffUnitFormula × List TffUnitFormula)
  | [] => none
  | unit :: rest =>
    match quantifiedClauseUnit? unit with
    | some (variables, regular) => some (variables, regular, rest)
    | none => do
      let (variables, regular, siblings) ← takeQuantifiedClause rest
      pure (variables, regular, unit :: siblings)

/-- AVATAR symbols generated by Vampire use the reserved `spl<n>_<m>` spelling. -/
private def isAvatarWord (word : String) : Bool :=
  word.startsWith "spl" && (word.drop 3).front.isDigit

private def isAvatarAtomic : TffAtomicFormula → Bool
  | .tffPlainAtomic (.constant (.mk (.mk word))) => isAvatarWord (wordText word)
  | .tffPlainAtomic (.functorTffArguments (.mk word) _) => isAvatarWord (wordText word)
  | _ => false

private partial def isAvatarUnitary : TffUnitaryFormula → Bool
  | .tffAtomicFormula atomic => isAvatarAtomic atomic
  | .tffLogicFormula (.tffUnitaryFormula unitary) => isAvatarUnitary unitary
  | _ => false

/-- Whether a clause literal is a possibly negated AVATAR split atom. This is a
syntactic guard for this preprocessing normalization; replay later resolves
the decoded symbol exactly. Only the literal's head symbol is inspected, so a
regular literal merely mentioning `spl` in an argument is not affected. -/
def isAvatarSyntaxLiteral : TffUnitFormula → Bool
  | .tffUnitaryFormula unitary => isAvatarUnitary unitary
  | .tffUnaryFormula (.tffPrefixUnary (.mk _ (.tffUnitaryFormula unitary))) =>
    isAvatarUnitary unitary
  | _ => false

/-- Decide whether two A-clause spellings differ in the order of their
first-order literal occurrences. The AVATAR part is deliberately filtered
out: replay treats it as a set after clause decoding, so an AVATAR-only order
change must not manufacture a redundant AC proof step. -/
def hasRegularLiteralPermutation (first second : TffLogicFormula) : Bool :=
  match clauseBody first, clauseBody second with
  | some first, some second =>
    match flattenClause first, flattenClause second with
    | some first, some second =>
      let first := first.filter (fun literal => !isAvatarSyntaxLiteral literal)
      let second := second.filter (fun literal => !isAvatarSyntaxLiteral literal)
      first.length == second.length &&
        !(List.zipWith (fun left right => literalUnitKey left == literalUnitKey right)
          first second).all id
    | _, _ => false
  | _, _ => false

/-- Keep just the AVATAR part of a normalized A-clause and apply the rule's
unifier to it. AVATAR literals are ordinarily nullary, but applying the same
syntax substitution makes this helper correct for any future parameterized
split symbol as well.

Forward subsumption removes one *regular* literal from its main parent. The
main tail already retains that parent's AVATAR literals; the side parent
contributes only its AVATAR literals to the natural clause-form conclusion. -/
def instantiatedAvatarPart (formula : TffLogicFormula)
    (substitution : Substitution) : Option (Option TffLogicFormula) := do
  let body ← clauseBody formula
  let literals ← flattenClause body
  let avatar := literals.filter isAvatarSyntaxLiteral
  match buildClause avatar with
  | none => pure none
  | some avatar => some <$> substLogic substitution avatar

def normalizeAClauseFormula (formula : TffLogicFormula) : TffLogicFormula :=
  (do
    let literals ← flattenClause formula
    let (variables, regular, siblings) ← takeQuantifiedClause literals
    guard (!siblings.isEmpty && siblings.all isAvatarSyntaxLiteral)
    let body ← buildClause (regular ++ siblings)
    pure <| TffLogicFormula.tffUnitaryFormula (.tffQuantifiedFormula
      (.mk (.fofQuantifier .exclamation) variables (unitOfLogic body)))).getD formula

def acOrigin? : TptpInput → Option (String × List Nat)
  | input => do
  let (_, _, _, annotations) ← tffNode? input
  let .sourceOptionalInfo (.dagSource (.inferenceRecord (.mk rule details proofParents))) _ := annotations
    | none
  guard (ruleText rule == "associativity_commutativity")
  let [parent] ← parentNames proofParents | none
  let permutationEntry ← (infoToList details).find? fun entry =>
    match application? entry with
    | some ("permutation", _) => true
    | _ => false
  let (_, arguments) ← application? permutationEntry
  let [entries] := arguments | none
  let .generalList entries := entries | none
  pure (parent, ← (listToList entries).mapM nat?)

/-- Given an AC node `actual` whose parent was spelled `reported`, translate a
literal position in the parent into its position in the AC node.  A permutation
`[0,2,1]` means output position 1 contains input position 2, hence we take the
inverse permutation here. -/
def positionAfterAc (origins : Std.HashMap String (String × List Nat))
    (actual reported : String) (index : Nat) : Nat :=
  if actual == reported then index
  else match origins.get? actual with
  | some (source, permutation) =>
    if source == reported then (permutation.findIdx? (· == index)).getD index else index
  | _ => index

private def acAnnotations (parent : String) (permutation : List Nat) : Annotations :=
  let details := info [application "permutation" [list (permutation.map number)]]
  .sourceOptionalInfo (.dagSource (.inferenceRecord
    (.mk (.mk (.lowerWord (.mk "associativity_commutativity"))) details (parents [parent])))) .nothing

def acNode (name : String) (role : FormulaRole) (formula : TffLogicFormula)
    (parent : String) (permutation : List Nat) : TptpInput :=
  .annotatedFormula (.tffAnnotated (.mk (lowerName name) role (.tffLogicFormula formula)
    (acAnnotations parent permutation)))

end VampireHammer.Preprocess.Internal
